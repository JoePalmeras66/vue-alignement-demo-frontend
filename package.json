{
  "name": "lppc",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test:unit": "vitest --environment jsdom --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "prepare-translations": "node ./scripts/yml2Json.js",
    "clean": "node  ./scripts/clean.js",
    "audit": "npm audit --registry=https://registry.npmjs.org/",
    "audit:fix": "npm audit --registry=https://registry.npmjs.org/ fix",
    "sbom:generate": "cyclonedx-npm --ignore-npm-errors --output-file ./pickcenterone-frontend-sbom.json"
  },
  "dependencies": {
    "@microsoft/signalr": "^6.0.10",
    "@tgw-components/web": "^5.3.20",
    "@vueuse/core": "^10.1.0",
    "axios": "^1.4.0",
    "devextreme": "^23.2.4",
    "devextreme-vue": "^23.2.4",
    "element-plus": "^2.2.17",
    "js-logger": "^1.6.1",
    "keycloak-js": "^21.1.1",
    "lodash-es": "^4.17.21",
    "pinia": "^2.1.4",
    "pinia-plugin-persistedstate": "^3.1.0",
    "sass": "^1.62.0",
    "ts-node": "^10.9.1",
    "uuid": "^9.0.0",
    "vue": "^3.4.23",
    "vue-i18n": "^9.7.0",
    "vue-router": "^4.1.6",
    "vue3-cookies": "^1.0.6",
    "vue3-lottie": "^2.5.0",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.39.1",
    "@cyclonedx/cyclonedx-npm": "^1.10.0",
    "@intlify/unplugin-vue-i18n": "^1.5.0",
    "@pinia/testing": "^0.1.2",
    "@types/jsdom": "^21.1.1",
    "@types/lodash-es": "^4.17.0",
    "@types/node": "^18.0.0",
    "@types/uuid": "^9.0.2",
    "@vitejs/plugin-vue": "^4.3.0",
    "@vitest/coverage-v8": "^1.1.3",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.4.0",
    "c8": "^7.13.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jsdom": "^22.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.4",
    "typescript": "~5.4.0",
    "unplugin-auto-import": "^0.16.7",
    "unplugin-vue-components": "^0.25.1",
    "vite": "^4.4.0",
    "vite-plugin-pages": "^0.30.1",
    "vite-plugin-static-copy": "^0.15.0",
    "vite-plugin-vue-layouts": "^0.8.0",
    "vitest": "^1.1.3",
    "vitest-sonar-reporter": "^0.4.0",
    "vue-tsc": "^2.0.0"
  }
}
